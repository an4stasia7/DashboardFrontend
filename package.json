{
  "name": "dashboard-desktop",
  "version": "1.0.7.1",
  "description": "Управленческий дашборд — desktop (Electron)",
  "main": "main.js",
  "author": "Dashboard",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "ru.dashboard.desktop",
    "productName": "Управленческий дашборд",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "css/**/*",
      "js/**/*",
      "node_modules/katex/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "an4stasia7",
        "repo": "DashboardFrontend",
        "releaseType": "release"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "dashboard-desktop-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "dashboard-desktop-portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "katex": "^0.16.21"
  }
}
